# Copy to .env to override defaults. All variables are optional.

# SQLite by default; for Postgres:
# SYSDRILL_DATABASE_URL=postgresql+psycopg://sysdrill:sysdrill@localhost:5432/sysdrill
SYSDRILL_DATABASE_URL=sqlite:///./sysdrill.db

SYSDRILL_SESSION_SIZE=10
SYSDRILL_NEW_CARDS_PER_DAY=5
SYSDRILL_DESIRED_RETENTION=0.9

# Only needed if you turn on "Enhanced security for push notifications" in your Expo project
# SYSDRILL_EXPO_ACCESS_TOKEN=

SYSDRILL_WORKER_INTERVAL_SECONDS=60

# Set to false in production: exposes /debug/run-reminders and /debug/users/{id}/test-push
SYSDRILL_ENABLE_DEBUG_ROUTES=true
