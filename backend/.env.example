# Copy to .env to override defaults. All variables are optional.

# SQLite by default; for Postgres:
# BITBYBIT_DATABASE_URL=postgresql+psycopg://bitbybit:bitbybit@localhost:5432/bitbybit
BITBYBIT_DATABASE_URL=sqlite:///./bitbybit.db

BITBYBIT_SESSION_SIZE=10
BITBYBIT_NEW_CARDS_PER_DAY=5
BITBYBIT_DESIRED_RETENTION=0.9

# Only needed if you turn on "Enhanced security for push notifications" in your Expo project
# BITBYBIT_EXPO_ACCESS_TOKEN=

BITBYBIT_WORKER_INTERVAL_SECONDS=60

# Set to false in production: exposes /debug/run-reminders and /debug/users/{id}/test-push
BITBYBIT_ENABLE_DEBUG_ROUTES=true
