{
  "expo": {
    "name": "bitbybit",
    "slug": "bitbybit",
    "scheme": "bitbybit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#2A0B1D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farbutnear.bitbybit"
    },
    "android": {
      "package": "com.farbutnear.bitbybit",
      "adaptiveIcon": {
        "backgroundColor": "#2A0B1D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#FF6FB8",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2A0B1D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
